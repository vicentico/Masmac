# Test para verificar que el endpoint de usuarios funciona correctamente
# Esto debería resolver el error 500 original

### GET all users
GET http://localhost:5233/api/Users
Accept: application/json

### POST create new user - Test válido
POST http://localhost:5233/api/Users
Content-Type: application/json

{
    "firstName": "Juan",
    "lastName": "Pérez",
    "email": "juan.perez@test.com",
    "phoneNumber": "+1234567890",
    "password": "Password123!",
    "address": {
        "street": "Calle Principal 123",
        "city": "Madrid",
        "state": "Madrid",
        "zipCode": "28001",
        "country": "Spain"
    }
}

