# VetUberApp Environment Variables
# Copy this file to .env and update with your actual values

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5233;https://+:7155

# MongoDB Configuration
MONGODB_CONNECTION_STRING=mongodb://root:password@localhost:27017
MONGODB_DATABASE_NAME=VetUberApp_Development

# For Docker development
MONGODB_CONNECTION_STRING_DOCKER=mongodb://root:password@host.docker.internal:27017

# Testing Configuration
MONGODB_CONNECTION_STRING_TEST=mongodb://root:password@localhost:27017/VetUberAppTest?authSource=admin

# Azure Configuration (for production)
# AZURE_COSMOSDB_CONNECTION_STRING=mongodb://your-cosmos-account:your-primary-key@your-cosmos-account.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@your-cosmos-account@

# Logging Configuration
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT_ASPNETCORE=Warning

# Security Configuration (for production)
# JWT_SECRET_KEY=your-super-secure-secret-key-here
# JWT_ISSUER=VetUberApp
# JWT_AUDIENCE=VetUberApp-Clients
# JWT_EXPIRY_MINUTES=60

# External Services (for future integrations)
# SENDGRID_API_KEY=your-sendgrid-api-key
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection

# Health Check Configuration
HEALTHCHECK_TIMEOUT_SECONDS=30
HEALTHCHECK_INTERVAL_SECONDS=10

# Rate Limiting (for production)
# RATE_LIMIT_REQUESTS_PER_MINUTE=100
# RATE_LIMIT_BURST_SIZE=20