<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    
    <!-- Project Metadata -->
    <AssemblyTitle>VetUberApp API</AssemblyTitle>
    <AssemblyDescription>REST API for veterinary home-service platform</AssemblyDescription>
    <AssemblyProduct>VetUberApp</AssemblyProduct>
    <AssemblyCompany>Masmac</AssemblyCompany>
    <AssemblyCopyright>Copyright © 2025 Masmac</AssemblyCopyright>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    
    <!-- Docker configuration -->
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.MongoDb" Version="8.0.0" />
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VetUberApp.Infrastructure\VetUberApp.Infrastructure.csproj" />
    <ProjectReference Include="..\VetUberApp.Application\VetUberApp.Application.csproj" />
  </ItemGroup>

</Project>
